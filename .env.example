# Browser requests always use same-origin /api in development and production.
# VITE_API_URL is no longer used; no hostname or LAN IP belongs in client config.
# Set these as SERVER environment variables in Vercel, never VITE_ variables.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.example/task-api
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=https://your-project.vercel.app
